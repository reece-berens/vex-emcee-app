# Copy this file to .env.local and fill in the values.
# .env.local is ignored by git, so real values never get committed.

# "demo" (sample data, no network calls) or "live" (the VEX Emcee API).
# Defaults to demo when unset.
NEXT_PUBLIC_DATA_SOURCE=demo

# Base URL of the VEX Emcee API, with a trailing slash. Only used in live mode.
NEXT_PUBLIC_BASE_URL=
